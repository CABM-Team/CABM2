[node name="KnowledgeIntro" type="Label" parent="MainLayout/TabContainer/知识库管理/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
theme_override_font_sizes/font_size = 26
text = "

知识库基于检索增强生成（RAG）技术，将文本内容转为向量存储。启用后，AI会根据语义从知识库中检索相关内容。
也就是说，你可以把整个世界观塞进去，不用担心字数限制。

技巧与建议：
• 为性能考虑，总条目建议少于10000条
• 可以包含角色设定、角色故事、世界观等等
• 每条知识需要独立、完整
• 建议使用“你”指代角色"
autowrap_mode = 1

