; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CABM2"
config/description="Code Afflatus & Beyond Matter - Godot Remake"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(1, 1, 1, 1)
config/icon="res://assets/icon.jpg"

[autoload]

AppState="*res://scripts/autoload/AppState.gd"
ConfigManager="*res://scripts/autoload/ConfigManager.gd"
ApiClient="*res://scripts/autoload/ApiClient.gd"
UITheme="*res://scripts/autoload/UITheme.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
