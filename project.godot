; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CABM2"
config/description="Code Afflatus & Beyond Matter - Godot Remake"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.2231029, 0.2231029, 0.22310287, 1)
boot_splash/image="uid://bbiaogtywno6j"
config/icon="res://assets/icon.jpg"

[autoload]

AppState="*res://scripts/autoload/AppState.gd"
ConfigManager="*res://scripts/autoload/ConfigManager.gd"
ApiClient="*res://scripts/autoload/ApiClient.gd"
EasyAI="*res://scripts/autoload/EasyAI.gd"
HistoryManager="*res://scripts/autoload/HistoryManager.gd"
GroupManager="*res://scripts/autoload/GroupManager.gd"
AndroidPermissions="*res://scripts/autoload/AndroidPermissions.gd"
UIStateManager="*res://scripts/autoload/UIStateManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"

[gui]

theme/custom="uid://buqhsbrq3g0n5"
theme/custom_font="uid://bgs1yfa1228cv"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
